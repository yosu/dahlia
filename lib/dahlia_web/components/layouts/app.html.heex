<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center gap-4 border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img src={~p"/images/logo.png"} width="36" />
      </a>
      <p class="bg-brand/5 text-brand rounded-full px-2 font-medium leading-6">
        v{Application.spec(:dahlia, :vsn)}
      </p>
    </div>
    <div class="flex items-center gap-4 leading-6">
      <%= if @active_menu == :water do %>
        水道料金
      <% else %>
        <.link navigate={~p"/water"} class="text-brand underline">
          水道料金
        </.link>
      <% end %>
      <%= if @active_menu == :gas do %>
        ガス料金
      <% else %>
        <.link navigate={~p"/gas"} class="text-brand underline">
          ガス料金
        </.link>
      <% end %>
    </div>
  </div>
</header>
<main class="px-4 lg:py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
